# Copy to .env for local overrides. .env is gitignored.

# Flask (local dev)
FLASK_HOST=127.0.0.1
FLASK_PORT=5180
FLASK_DEBUG=0

# SQLite location override. Railway sets this to /data/portfolio.db;
# locally it defaults to data/portfolio.db.
# PORTFOLIO_DB=

# In-process cron (prices every 5 min + daily P&L after US close).
# Set to 1 in prod; leave unset locally to avoid background jobs.
# ENABLE_CRON=1

# Timezone for "today" math and the scheduler.
# TZ=Australia/Sydney

# API protection: when set, every /api/* request except /api/health requires
# `Authorization: Bearer <token>`. The dashboard prompts once and keeps it in
# localStorage. Do not place the real token in this file or commit it.
# API_TOKEN=
